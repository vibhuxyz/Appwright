{
  "name": "devian",
  "private": true,
  "packageManager": "bun@1.3.13",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "services/web",
    "services/api",
    "services/orchestrator",
    "libs/ts/*"
  ],
  "scripts": {
    "dev:web": "bun --filter web dev",
    "dev:api": "bun --filter api dev",
    "build": "bun --filter '*' build",
    "lint": "bun --filter '*' lint",
    "check-types": "bun --filter '*' check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "prettier": "^3.7.4",
    "typescript": "5.9.2"
  }
}
