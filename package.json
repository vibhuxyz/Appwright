{
  "name": "appwright",
  "private": true,
  "packageManager": "bun@1.3.13",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "services/web",
    "services/api",
    "services/orchestrator",
    "libs/ts/*"
  ],
  "scripts": {
    "agent": "bun libs/ts/agent-core/src/cli.ts",
    "dev": "docker compose up -d --build",
    "dev:api": "bun --filter api dev",
    "dev:web": "bun --filter web dev",
    "down": "docker compose down",
    "logs": "docker compose logs -f",
    "build": "bun --filter '*' build",
    "test": "bun test",
    "lint": "bun --filter '*' lint",
    "check-types": "bun --filter '*' check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:migrate": "cd libs/ts/db && bunx prisma migrate dev",
    "db:studio": "cd libs/ts/db && bunx prisma studio"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "prettier": "^3.7.4",
    "typescript": "5.9.2"
  }
}
