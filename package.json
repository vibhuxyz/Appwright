{
  "name": "appwright",
  "private": true,
  "packageManager": "bun@1.3.13",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/web",
    "apps/api",
    "apps/orchestrator",
    "apps/agent",
    "packages/*",
    "workers/*",
    "scripts"
  ],
  "scripts": {
    "agent": "bun scripts/agent.ts",
    "ui:emit": "bun packages/ui-system/bin/emit.ts",
    "ui:check": "bun packages/ui-system/bin/emit.ts --check",
    "dev": "turbo run dev --filter=web --filter=api --filter=agent-worker --filter=orchestrator",
    "dev:api": "bun --filter api dev",
    "dev:web": "bun --filter web dev",
    "dev:agent": "bun --filter agent-worker dev",
    "dev:v3": "bun run dev",
    "dev:workers": "turbo run dev --filter=worker-indexing --filter=worker-evaluation --filter=worker-maintenance",
    "infra:up": "docker compose up -d postgres redis mongo",
    "infra:down": "docker compose down",
    "down": "docker compose down",
    "logs": "docker compose logs -f",
    "build": "turbo run build",
    "test": "bun test apps packages --path-ignore-patterns 'ref-ai/**'",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:migrate": "cd packages/db && bunx prisma migrate dev",
    "db:studio": "cd packages/db && bunx prisma studio",
    "health:check": "bun scripts/health-check.ts",
    "bootstrap": "bun scripts/bootstrap.ts",
    "db:seed": "bun scripts/seed.ts",
    "postinstall": "DATABASE_URL=${DATABASE_URL:-postgresql://localhost:5432/prisma-generate} bun run --filter @repo/db db:generate"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "prettier": "^3.7.4",
    "turbo": "^2.5.4",
    "typescript": "5.9.2"
  }
}
