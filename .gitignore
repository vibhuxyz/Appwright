node_modules
.pnp
.pnp.js
dist
build
out/
.next/
.vite

# ─── Python ───
.venv
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ─── Local env ───
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ─── Generated project workspaces (the agent's working copies) ───
/workspaces/

# ─── Testing ───
coverage

# ─── Tooling ───
