{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "typeRoots": ["../../../templates/nextjs-fullstack/node_modules/@types"],
    "types": ["react", "react-dom"],
    "paths": {
      "@/components/ui/*": ["../components/*"],
      "@/components/patterns/*": ["./*"],
      "lenis/react": ["../../../templates/nextjs-fullstack/node_modules/lenis/dist/lenis-react.d.ts"],
      "*": ["../../../templates/nextjs-fullstack/node_modules/@types/*", "../../../templates/nextjs-fullstack/node_modules/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
