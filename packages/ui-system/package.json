{
  "name": "@repo/ui-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./sections": "./src/sections/index.ts",
    "./server": "./src/server/index.ts"
  },
  "scripts": {
    "emit": "bun bin/emit.ts",
    "emit:check": "bun bin/emit.ts --check",
    "check-types": "tsc --noEmit",
    "check-patterns": "tsc --noEmit -p patterns/tsconfig.json",
    "vendor:effects": "bun bin/vendor-effects.ts",
    "build": "tsup src/index.ts --format esm --dts",
    "emit:props": "bun bin/emit-pattern-props.ts",
    "emit:props:check": "bun bin/emit-pattern-props.ts --check"
  },
  "dependencies": {
    "@repo/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.9.3",
    "tsup": "^8.3.5",
    "typescript": "5.9.2",
    "zod": "^4.4.3"
  }
}
