{
  "name": "@repo/agent-core",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts"
  },
  "bin": {
    "appwright": "./src/cli.ts"
