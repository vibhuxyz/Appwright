generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(cuid()) @db.VarChar(30)
  email        String    @unique
  hashPassword String
  // Starting credits granted on registration: .00 in AI balance (10,000,000 tokens)
  credits      Int       @default(10000000)
  plan         Plan      @default(FREE)
  projects     Project[]
  // One Vercel account link per user, not per project. Connecting is a
  // property of the person, deploying is a property of the app.
  vercelConnection VercelConnection?
  integrationAuditEvents IntegrationAuditEvent[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
}

// D41 amendment — the connection outlives any single project. It used to be
// a Secret row keyed by projectId, which meant (a) the user reconnected for
// every new app and (b) deleting a project cascade-deleted their Vercel
// link. Both were the same modelling error: one table holding two facts with
// different lifetimes.
//
// `configurationId` is Vercel's handle for *this installation* — it is what
// makes Disconnect and "reinstalled vs two installs" answerable. D41 lists
// token lifecycle as a recorded cost; this column is the part that pays it.
model VercelConnection {
  id              String   @id @default(cuid()) @db.VarChar(30)
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  encryptedToken  String
  teamId          String?
  configurationId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
}

model Project {
  id            String        @id @default(cuid()) @db.VarChar(30)
  name          String
  templateId    String        @default("vite-react")
  starterId     String?       @map("starter_id")
  workspacePath String
  status        ProjectStatus @default(READY)
  // Non-null since auth landed. A project with no owner is unreachable by
  // every route, so allowing the state at all only invited rows nobody could
  // see. Deleting the user takes their projects with them.
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Which Vercel project this app deploys to. The connection half lives on
  // the User; this is the link half, and it dies with the project.
  vercelProjectId String?
  sessions      Session[]
  secret        Secret[]
  assets        ProjectAsset[]
  databases     ProjectDatabase[]
  integrations  ProjectIntegration[]
  integrationUsage IntegrationUsage[]
  integrationPayments IntegrationPayment[]
  integrationWebhookEvents IntegrationWebhookEvent[]
  integrationAccessTokens ProjectIntegrationAccessToken[]
  integrationAuditEvents IntegrationAuditEvent[]
  envVariables  ProjectEnvironmentVariable[]
  attachments   ProjectAttachment[]
  integrationRequests IntegrationRequest[]
  // Deleting a project cleans up its sessions/messages/secrets too — there's
  // no route that deletes a session or secret on its own in V1.
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt

  @@index([userId])
}

model Session {
  id           String        @id @default(cuid()) @db.VarChar(30)
  projectId    String
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title        String?
  model        String        @default("gpt-5.4-mini")
  cost         Float         @default(0)
  tokenIn      Int           @default(0)
  tokenOut     Int           @default(0)
  // Wall-clock seconds a sandbox existed for this session, summed across
  // every job. D25's first reopen trigger ("should we move off E2B?") needs
  // a number, not a feeling — this is that number's other half, alongside
  // tokens.
  sandboxSeconds Int         @default(0)
  status       SessionStatus @default(IDLE)
  branch       String?
  worktreePath String?
  mode         String        @default("default")
  devPort      Int?
  // Random, unguessable — the actual access credential for the preview
  // proxy. Rotated every time /session/:id/preview is called, so an old
  // link stops working once the dev server it pointed at is gone.
  previewToken String?       @unique
  allowedTools String[]      @default([])
  messages     Message[]
  approvals    Approval[]
  jobs         Job[]
  blueprints   Blueprint[]
  runs         Run[]
  assetRequests AssetRequest[]
  assets       ProjectAsset[]
  attachments  ProjectAttachment[]
  agentQuestions AgentQuestion[]
  integrationRequests IntegrationRequest[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt

  @@index([projectId])
}

model Approval {
  id         String         @id @default(cuid()) @db.VarChar(30)
  sessionId  String
  session    Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  messageId  String?
  toolCallId String?
  toolName   String
  args       Json
  status     ApprovalStatus @default(PENDING)
  createdAt  DateTime       @default(now())
  resolvedAt DateTime?

  @@index([sessionId])
  @@index([sessionId, status])
}

model AgentQuestion {
  id         String    @id @default(uuid(7)) @db.Uuid
  sessionId  String    @map("session_id") @db.VarChar(30)
  session    Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  toolCallId String?   @map("tool_call_id")
  questions  Json
  answers    Json?
  status     String    @default("PENDING")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([sessionId, status], map: "idx_agent_questions__session_id_status")
  @@map("agent_questions")
}

model Message {
  id        String   @id @default(cuid()) @db.VarChar(30)
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  // Monotonic per session — every history read is ordered by it, and it's
  // what a stream reconnect asks for ("everything after seq N").
  seq       Int
  role      String
  type      String
  content   String
  data      Json?
  createdAt DateTime @default(now())

  @@unique([sessionId, seq])
  @@index([sessionId, seq])
}


model Blueprint {
  id               String         @id @default(cuid()) @db.VarChar(30)
  sessionId        String
  session          Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  blueprintVersion Int
  intent           Json
  stack            Json
  entities         Json
  pages            Json
  features         Json
  theme            Json
  design           Json?
  layout           Json?
  responsive       Json?
  projectType      String?
  requirements     Json?
  dependencyManifest Json?
  specification    Json?
  tasks            Task[]
  changeRequests   ChangeRequest[]
  assetRequests    AssetRequest[]
  createdAt        DateTime       @default(now())

  @@unique([sessionId, blueprintVersion])
  @@index([sessionId])
}

enum Plan {
  FREE
  PRO
  MAX
}

enum AssetRequestStatus {
  PENDING
  RESOLVED
}

enum AssetSource {
  UPLOADED
  GENERATED
  SEARCHED
}

// Ephemeral per-blueprint Q&A gate: one row per Blueprint, `slots` holds
// the detected image slots and their in-progress state (which status is
// queried by the chat card). Resolved slots become durable ProjectAsset
// rows; this row's only job is tracking "is every slot resolved yet".
model AssetRequest {
  id          String             @id @default(cuid()) @db.VarChar(30)
  sessionId   String
  session     Session            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  blueprintId String
  blueprint   Blueprint          @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  slots       Json
  status      AssetRequestStatus @default(PENDING)
  createdAt   DateTime           @default(now())
  resolvedAt  DateTime?

  @@index([sessionId])
  @@index([blueprintId])
  @@index([sessionId, status])
}

// Durable asset library row, one per finished image (uploaded or
// AI-generated). Populates the project's Assets tab independently of
// whichever AssetRequest produced it.
model ProjectAsset {
  id                 String      @id @default(cuid()) @db.VarChar(30)
  projectId          String
  project            Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sessionId          String
  session            Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  purpose            String
  source             AssetSource
  prompt             String?
  cloudinaryPublicId String
  cloudinaryUrl      String
  localPath          String
  altText            String
  externalId         String?
  attribution        Json?
  createdAt          DateTime    @default(now())

  @@index([projectId])
  @@index([sessionId])
}

enum AttachmentType {
  IMAGE
  PDF
  DOCUMENT
}

enum AttachmentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model ProjectAttachment {
  id            String           @id @default(cuid()) @db.VarChar(30)
  projectId     String
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sessionId     String
  session       Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  messageId     String?
  name          String
  mimeType      String
  sizeBytes     Int
  storageKey    String
  type          AttachmentType
  status        AttachmentStatus @default(PENDING)
  metadata      Json?
  extractedText String?          @db.Text
  analysis      Json?
  errorMessage  String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @default(now()) @updatedAt

  @@index([projectId])
  @@index([sessionId])
  @@index([messageId])
}

enum TaskType {
  SCAFFOLD
  SCHEMA
  AUTH
  PAYMENT
  MIGRATION
  API
  SEED
  PAGE
  COMPONENT
  THEME
  DESIGN_SYSTEM
  APP_SHELL
  TYPOGRAPHY
  LAYOUT
  RESPONSIVE
  VISUAL_VERIFICATION
  ADMIN
  MEDIA
  SEO
  SECURITY
  TESTING
  DEPLOY
}

enum RiskTier {
  LOW
  MEDIUM
  HIGH
}

enum Capability {
  STRONG_REASONING
  STRONG_CODING
  FAST_CODING
  CHEAP
}

enum TaskStatus {
  PENDING
  READY
  RUNNING
  BLOCKED
  FAILED
  DONE
}

// D30: owns/reads is the graph — dependency edges, write-fence scope,
// context scope, and parallel eligibility all read from the same two
// fields. dependsOn is stored, not recomputed, so the executor never
// re-derives the graph mid-run (ARCHITECTURE §11).
model Task {
  id           String        @id @default(cuid()) @db.VarChar(30)
  blueprintId  String
  blueprint    Blueprint     @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  type         TaskType
  title        String
  status       TaskStatus    @default(PENDING)
  dependsOn    Json
  owns         Json
  reads        Json
  riskTier     RiskTier
  capability   Capability
  verification Json
  attempts     TaskAttempt[]
  changeRequests ChangeRequest[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt

  @@index([blueprintId])
  @@index([blueprintId, status])
}

enum RunTrigger {
  INITIAL
  FOLLOWUP
  RETRY
  HEAL
}

enum RunStatus {
  QUEUED
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

// What the UI shows progress for, what Stop cancels, what a budget is
// enforced against (D38). A Task is deliberately NOT owned by a Run — a
// retry run re-executes a task an earlier run created.
model Run {
  id               String        @id @default(cuid()) @db.VarChar(30)
  sessionId        String
  session          Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  blueprintVersion Int
  trigger          RunTrigger
  status           RunStatus     @default(QUEUED)
  budgetUsd        Float
  totalCostUsd     Float         @default(0)
  startedAt        DateTime?
  completedAt      DateTime?
  error            String?
  attempts         TaskAttempt[]
  events           RunEvent[]
  createdAt        DateTime      @default(now())

  @@index([sessionId])
}

enum TaskAttemptStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

// Telemetry lives here, never on Task — overwriting it onto the task keeps
// only the last try, and then D31's routing can't be evaluated and V6's
// loop detection has nothing to compare (D35).
model TaskAttempt {
  id            String            @id @default(cuid()) @db.VarChar(30)
  taskId        String
  task          Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  runId         String
  run           Run               @relation(fields: [runId], references: [id], onDelete: Cascade)
  attemptNumber Int
  status        TaskAttemptStatus @default(RUNNING)
  model         String
  costUsd       Float             @default(0)
  tokenIn       Int               @default(0)
  tokenOut      Int               @default(0)
  durationMs    Int?
  commitSha     String?
  error         String?
  verification  Json?
  createdAt     DateTime          @default(now())

  @@unique([taskId, attemptNumber])
  @@index([taskId])
  @@index([runId])
}

// The execution timeline, separate from Message (the conversation) — D40.
model RunEvent {
  id        String   @id @default(cuid()) @db.VarChar(30)
  runId     String
  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  type      String
  data      Json
  seq       Int
  createdAt DateTime @default(now())

  @@unique([runId, seq])
  @@index([runId, seq])
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// D34: a generation agent that believes the frozen architecture is wrong
// raises this; it does not act. Approval bumps blueprintVersion and
// recomputes only the affected part of the DAG.
model ChangeRequest {
  id          String               @id @default(cuid()) @db.VarChar(30)
  blueprintId String
  blueprint   Blueprint            @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  taskId      String
  task        Task                 @relation(fields: [taskId], references: [id], onDelete: Cascade)
  wanted      String
  why         String
  status      ChangeRequestStatus  @default(PENDING)
  createdAt   DateTime             @default(now())
  resolvedAt  DateTime?

  @@index([blueprintId])
  @@index([taskId])
}

// V3: one row per agent run, durable across worker crashes. The payload is
// an id, not a blob (doc: "the worker reads state from Postgres") — the
// prompt and history live on Message, this just tracks dispatch state.
model Job {
  id         String    @id @default(cuid()) @db.VarChar(30)
  sessionId  String
  session    Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  projectId  String
  status     JobStatus @default(QUEUED)
  retryCount Int       @default(0)
  maxRetries Int       @default(3)
  workerId   String?
  // Null while queued. Set on claim, renewed on heartbeat. A worker that
  // crashes stops renewing it — any other live worker's poll tick finds it
  // past due and requeues the job. This is the cross-process lease: the
  // in-memory LeaseManager only protects against a stall inside one process.
  leaseExpiresAt DateTime?
  error      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt

  @@index([status])
  @@index([sessionId])
}

model Secret {
  id             Int      @id @default(autoincrement())
  key            String
  encryptedValue String
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@unique([projectId, key])
}

enum ProjectStatus {
  PROVISIONING
  BUILDING
  READY
  ERROR
}

enum SessionStatus {
  IDLE
  RUNNING
  AWAITING_APPROVAL
  ERROR
}

enum ApprovalStatus {
  PENDING
  APPROVED
  DENIED
}

enum JobStatus {
  QUEUED
  PROVISIONING
  RUNNING
  AWAITING_APPROVAL
  VERIFYING
  SUCCEEDED
  FAILED
  CANCELLED
}

// One logical MongoDB database per generated project + environment on the
// shared cluster (D15/D61). The URI lives in Secret; this row is metadata
// only. secretRef is Secret.id as a string — never the credential.
enum ProjectDatabaseStatus {
  PENDING
  PROVISIONING
  READY
  FAILED
  PENDING_DELETE
}

enum ProjectDatabaseEnvironment {
  DEVELOPMENT
  PREVIEW
  PRODUCTION
}

enum ProjectDatabaseProvider {
  MONGODB
}

enum ProjectDatabaseIsolation {
  SCOPED_USER
  SHARED_CLUSTER_USER
}

model ProjectDatabase {
  id               String                      @id @default(cuid()) @db.VarChar(30)
  projectId        String
  project          Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment      ProjectDatabaseEnvironment
  provider         ProjectDatabaseProvider     @default(MONGODB)
  databaseName     String
  isolationMode    ProjectDatabaseIsolation
  status           ProjectDatabaseStatus       @default(PENDING)
  secretRef        String?
  migrationVersion Int                         @default(0)
  lastErrorCode    String?
  retryCount       Int                         @default(0)
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @default(now()) @updatedAt

  @@unique([projectId, environment], map: "uq_project_databases__project_id_environment")
  @@unique([databaseName], map: "uq_project_databases__database_name")
  @@index([projectId], map: "idx_project_databases__project_id")
  @@index([status], map: "idx_project_databases__status")
}

// Survives Project cascade so a user-initiated delete cannot drop Mongo
// data immediately. The maintenance worker reaps rows whose deleteAfter
// has passed.
model DatabaseDeletion {
  id           String                     @id @default(cuid()) @db.VarChar(30)
  databaseName String
  username     String
  provider     ProjectDatabaseProvider    @default(MONGODB)
  projectId    String
  environment  ProjectDatabaseEnvironment
  deleteAfter  DateTime
  status       String                     @default("scheduled")
  lastErrorCode String?
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @default(now()) @updatedAt

  @@unique([databaseName], map: "uq_database_deletions__database_name")
  @@index([deleteAfter, status], map: "idx_database_deletions__delete_after_status")
}

model ProjectIntegration {
  id           String    @id @default(cuid()) @db.VarChar(30)
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  provider     String
  status       String    @default("missing")
  required     Boolean   @default(false)
  config       Json?
  lastTestedAt DateTime?
  lastError    String?
  environments ProjectIntegrationEnvironment[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  @@unique([projectId, provider], map: "uq_project_integrations__project_id_provider")
  @@index([projectId], map: "idx_project_integrations__project_id")
}

model ProjectIntegrationEnvironment {
  id                   String            @id @default(cuid()) @db.VarChar(30)
  integrationId        String            @db.VarChar(30)
  integration          ProjectIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  environment          String
  credentialMode       String            @default("BYOK")
  status               String            @default("configuration_required")
  lastTestedAt         DateTime?         @db.Timestamptz(3)
  lastError            String?
  createdAt            DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime          @default(now()) @updatedAt @db.Timestamptz(3)

  @@unique([integrationId, environment], map: "uq_project_integration_env__integration_environment")
  @@index([integrationId], map: "idx_project_integration_env__integration_id")
}

model IntegrationRequest {
  id         String    @id @default(uuid(7)) @db.Uuid
  sessionId  String    @map("session_id") @db.VarChar(30)
  session    Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  projectId  String    @map("project_id") @db.VarChar(30)
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  provider   String
  reason     String
  status     String    @default("PENDING")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([sessionId, provider], map: "uq_integration_requests__session_id_provider")
  @@index([projectId, provider, status], map: "idx_integration_requests__project_id_provider_status")
  @@map("integration_requests")
}

model IntegrationUsage {
  id                String   @id @default(cuid()) @db.VarChar(30)
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  provider          String
  credentialMode    String
  environment       String
  operation         String
  idempotencyKey    String   @db.VarChar(128)
  requestFingerprint String
  status            String
  units             Int      @default(1)
  providerRequestId String?
  resultJson        Json?
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  @@unique([projectId, provider, operation, environment, idempotencyKey], map: "uq_integration_usage__project_provider_operation_key")
  @@index([projectId, provider, credentialMode, status], map: "idx_integration_usage__quota_lookup")
}

model IntegrationPayment {
  id              String   @id @default(cuid()) @db.VarChar(30)
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  provider        String
  environment     String
  credentialMode  String
  providerOrderId String
  paymentId       String?
  amountMinor     BigInt
  currency        String   @db.VarChar(3)
  status          String   @default("created")
  idempotencyKey  String   @db.VarChar(128)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@unique([projectId, environment, idempotencyKey], map: "uq_integration_payments__project_environment_key")
  @@unique([projectId, providerOrderId], map: "uq_integration_payments__project_provider_order")
  @@index([projectId, environment, status], map: "idx_integration_payments__project_env_status")
}

model IntegrationWebhookEvent {
  id          String   @id @default(cuid()) @db.VarChar(30)
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  provider    String
  eventId     String
  payloadHash String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@unique([projectId, provider, eventId], map: "uq_integration_webhooks__project_provider_event")
  @@index([projectId, provider], map: "idx_integration_webhooks__project_provider")
}

model ProjectIntegrationAccessToken {
  id        String   @id @default(cuid()) @db.VarChar(30)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment String
  tokenHash String   @unique
  encryptedToken String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@unique([projectId, environment], map: "uq_project_integration_tokens__project_environment")
}

model IntegrationAuditEvent {
  id          String   @id @default(cuid()) @db.VarChar(30)
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorUserId String
  actor       User     @relation(fields: [actorUserId], references: [id], onDelete: Cascade)
  provider    String
  environment String
  action      String
  status      String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([projectId, createdAt], map: "idx_integration_audit_events__project_created")
  @@index([actorUserId], map: "idx_integration_audit_events__actor")
}

model ProjectEnvironmentVariable {
  id          String   @id @default(cuid()) @db.VarChar(30)
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment String
  key         String
  value       String?
  isSecret    Boolean  @default(false)
  secretRef   Int?
  required    Boolean  @default(true)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@unique([projectId, environment, key], map: "uq_project_env_vars__project_environment_key")
  @@index([projectId], map: "idx_project_env_vars__project_id")
  @@index([projectId, environment], map: "idx_project_env_vars__project_id_environment")
}
