{
  "name": "@repo/db",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "exports": "./src/index.ts",
  "scripts": {
    "db:script": "bun run src/script.ts",
    "db:studio": "bunx --bun prisma studio",
    "db:generate": "bunx --bun prisma generate",
    "db:migrate": "bunx --bun prisma migrate dev ",
    "build": "tsup src/index.ts --format esm"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.9.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.20.0",
    "prisma": "^7.8.0",
    "tsup": "^8.3.5",
    "tsx": "^4.22.4"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@repo/contracts": "workspace:*",
    "dotenv": "^17.4.2",
    "mongodb": "^7.7.0",
    "pg": "^8.21.0",
    "zod": "^4.6.7"
  }
}
