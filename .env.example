# Appwright — copy to `.env` at the repo root for local V3 (API + agent worker + local/E2B sandbox).
# Never commit real secrets. Generate AUTH_SECRET / SECRETS_ENCRYPTION_KEY with: openssl rand -hex 32

# ── Core infra ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://appwright:appwright@localhost:5432/appwright
REDIS_URL=redis://localhost:6379
PORT=3001
WORKSPACE_ROOT=.workspaces

# ── Auth & secrets ──────────────────────────────────────────────────────────
# JWT signing secret for @repo/auth (required to start the API).
AUTH_SECRET=
# AES key material for encrypting stored OAuth tokens (Vercel connect). Required when using /vercel.
SECRETS_ENCRYPTION_KEY=

# ── Public origins (browser-facing) ─────────────────────────────────────────
PUBLIC_API_URL=http://localhost:3001
WEB_APP_URL=http://localhost:3000
# Vite web app → API base URL (apps/web).
VITE_API_URL=http://localhost:3001

# ── Model provider (agent-core OpenAiProvider) ──────────────────────────────
# Set the key that matches DEFAULT_MODEL / MODEL_PROVIDERS:
#   openai → OPENAI_API_KEY, gemini → GEMINI_API_KEY, groq → GROQ_API_KEY, xai → XAI_API_KEY
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
DEFAULT_MODEL=gpt-5.4-mini

# ── V3 execution / sandbox ──────────────────────────────────────────────────
# unset or anything other than "sandboxed" → in-process runConversation (default).
# sandboxed → POST /conversation returns 202 + jobId; apps/agent polls and runs in a sandbox.
EXECUTION_MODE=
# local (default) | e2b — used by createSandboxProviderFromEnv() in the agent worker.
SANDBOX_PROVIDER=local
# Required when SANDBOX_PROVIDER=e2b.
E2B_API_KEY=

# ── Optional: Vercel OAuth (deploy connect) ─────────────────────────────────
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
VERCEL_INTEGRATION_SLUG=
# Optional override — defaults to ${PUBLIC_API_URL}/vercel/callback.
VERCEL_REDIRECT_URI=

# ── Optional: event bus workers (docker compose --profile events) ───────────
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=appwright

# ── Optional: logging ───────────────────────────────────────────────────────
LOG_LEVEL=info

# ── How to run the sandboxed worker ─────────────────────────────────────────
# After: docker compose up -d postgres redis
#        cd packages/db && bunx --bun prisma migrate deploy
#        set EXECUTION_MODE=sandboxed in .env
# Start worker: bun --filter agent-worker dev
