# ── Appwright V3 — copy to `.env` and fill in ─────────────────────────────
# Never commit real secrets. Values below are placeholders.

# Postgres (docker compose up -d postgres)
DATABASE_URL=postgresql://appwright:appwright@localhost:5432/appwright

# Shared MongoDB cluster that hosts each generated project's logical database.
# Administrative URI for Appwright only. Generated apps get a per-project
# runtime URI as MONGODB_URI via Secret, never this value.
MONGO_DB_PROJECT_DATABASE=mongodb://localhost:27017
# Local docker mongo has no auth, so provisioning records
# isolationMode=shared-cluster-user. Production should set
# MONGODB_REQUIRE_SCOPED_USERS=true on a cluster that supports createUser.
# MONGODB_REQUIRE_SCOPED_USERS=true
# MAX_PROJECT_DATABASES_PER_USER=50
# PROJECT_DATABASE_RETENTION_DAYS=7

# Redis — rate limits, cancel flags, SSE pub/sub (docker compose up -d redis)
REDIS_URL=redis://localhost:6379

# Auth JWT signing secret (long random string)
AUTH_SECRET=replace-with-a-long-random-secret

# Encrypts stored third-party secrets at rest (32+ bytes)
SECRETS_ENCRYPTION_KEY=replace-with-another-long-random-secret

# HTTP
PORT=3001
PUBLIC_API_URL=http://localhost:3001
WEB_APP_URL=http://localhost:3000
VITE_API_URL=http://localhost:3001

# Generated project files land here (absolute or repo-relative)
WORKSPACE_ROOT=.workspaces

# LLM — set the key that matches DEFAULT_MODEL's provider
# openai → OPENAI_API_KEY | gemini → GEMINI_API_KEY | groq → GROQ_API_KEY
# xai → XAI_API_KEY | deepseek → DEEPSEEK_API_KEY | anthropic → ANTHROPIC_API_KEY
DEFAULT_MODEL=gpt-5.4-mini
# Model for intake questions, plan previews and blueprint planning. Leave empty to use the best model with a key.
PLANNER_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
# GROQ_API_KEY=
# XAI_API_KEY=
# DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=

# Cloudinary — one org-level account, shared across every user and project.
# Assets are foldered as appwright/{userId}/{projectId}/{uploads|generated}/{purpose}.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Image generation provider for the "generate with AI" asset option.
# gemini is the only provider shipped; others plug into @repo/media's registry.
IMAGE_PROVIDER=gemini

# Google Custom Search — fills a section image when the user chooses
# "Decide for me". Wikimedia Commons is the fallback when these are empty.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Unsplash — server-only access key (https://unsplash.com/developers). Powers the
# "Search photos" panel and is tried first for "Decide for me". Photos are hotlinked
# from images.unsplash.com and credited, never copied. The demo tier allows 50
# requests/hour, so identical searches are cached for 10 minutes.
UNSPLASH_ACCESS_KEY=

# ── Execution ────────────────────────────────────────────────────────────
# API enqueues a Job; apps/agent claims it and runs tools inside a sandbox
# (Local or E2B).
# local = child-process supervisor on this machine (default, free, for dev)
# e2b   = real cloud sandbox (needs E2B_API_KEY from https://e2b.dev)
SANDBOX_PROVIDER=local
E2B_API_KEY=

# Optional: Kafka only if you use the events profile
# KAFKA_BROKERS=localhost:9092

# Open every built app in headless Chromium after verification passes.
# Needs `bun run --cwd packages/browser install-browser` once per machine. Set to false to skip.
# BROWSER_CHECK=true

# Optional: Vercel OAuth deploy integration
# VERCEL_CLIENT_ID=
# VERCEL_CLIENT_SECRET=
# VERCEL_INTEGRATION_SLUG=
# VERCEL_REDIRECT_URI=http://localhost:3001/auth/vercel/callback
